{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKrisp",
  "version": "0.1.0-beta.4",
  "identifier": "app.openkrisp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenKrisp",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "locales/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "locales/pt-BR.lproj/InfoPlist.strings": "pt-BR.lproj/InfoPlist.strings",
      "locales/fr.lproj/InfoPlist.strings": "fr.lproj/InfoPlist.strings",
      "locales/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../../../models/LICENSE": "models/LICENSE",
      "../../../models/LICENSE-MIT": "models/LICENSE-MIT",
      "../../../models/LICENSE-APACHE": "models/LICENSE-APACHE",
      "../../../models/DeepFilterNet3_ll_onnx.tar.gz": "models/DeepFilterNet3_ll_onnx.tar.gz",
      "../../../models/manifest.json": "models/manifest.json",
      "../../../third_party/aec/notices/": "third-party/aec/notices/",
      "../../../third_party/aec/README.md": "third-party/aec/README.md",
      "../../../third_party/aec/SHA256.json": "third-party/aec/SHA256.json"
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0 (>= 0.3.53)",
          "pipewire (>= 0.3.53)",
          "pipewire-bin",
          "wireplumber",
          "pipewire-pulse",
          "pkexec"
        ]
      },
      "rpm": {
        "depends": [
          "(pipewire-libs >= 0.3.53 and pipewire >= 0.3.53)",
          "pipewire-utils",
          "wireplumber",
          "pipewire-pulseaudio",
          "polkit"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
